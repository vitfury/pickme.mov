{
  "name": "pickme-mov",
  "version": "1.0.0",
  "private": true,
  "description": "Tinder-style movie discovery PWA",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "seed": "tsx scripts/seed.ts",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:export": "bash scripts/db-export.sh",
    "db:import": "bash scripts/db-import.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
